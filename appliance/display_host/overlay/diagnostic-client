#!/usr/bin/python3 -IB
"""Launcher Weston's shell execs for its private client (shell.c `start_diagnostic`; path unchanged).

-I implies -P (Python >= 3.11): this file's own directory is not on sys.path, so the launcher puts it
there before importing the `overlay` package installed beside it, then photo-wall-common's directory
(a Depends of photo-wall-node-display) for `contracts`, whose Frame region the overlay reads (#124).
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(1, "/usr/lib/photo-wall/common")   # contracts (photo-wall-common): the Frame region

from overlay.client import main  # noqa: E402

sys.exit(main())
