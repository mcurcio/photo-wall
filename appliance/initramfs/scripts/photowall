#!/bin/sh
# initramfs-tools sources the boot=photowall script and calls mountroot.
mount_top() { :; }
mount_premount() { :; }
mount_bottom() { :; }
mountroot()
{
    # Noble panic() honors this value and reboots without opening a shell.
    # Keep it explicit here as well as in the common kernel command line.
    panic=10
    configure_networking
    if ! /usr/bin/python3.12 -I -m appliance.bootstrap --rootmnt "$rootmnt"; then
        echo "photo-wall: boot_failed" >&2
        sleep 5
        reboot -f
        # Fail closed if reboot is unavailable; never enter an interactive shell.
        while :; do sleep 60; done
    fi
}
