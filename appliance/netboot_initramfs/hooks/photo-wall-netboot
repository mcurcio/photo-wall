#!/bin/sh
# photo-wall-netboot-init's initramfs-tools hook, installed as
# /usr/share/initramfs-tools/hooks/photo-wall-netboot (decision 0019 P4). Stages
# into the initrd the interpreter, its stdlib and the userland the slim,
# UNSIGNED netboot init (appliance.netboot_init) needs, then stage 1 itself:
#
#   * the contents of each package directory the package's path file lists
#     (/usr/lib/photo-wall/netboot-init/path: the directories stage 1's imports
#     reach, held by scripts/import_check.py to its computed launcher path),
#     copied into the interpreter's stdlib dir, where
#     `python3 -I -m appliance.netboot_init` finds them. Whole directories, so
#     photo-wall-common's nodeapi rides along, never imported;
#   * this root's /etc/ssl/certs/ca-certificates.crt, the CA bundle stage 1's
#     Trust loads (R5). The root and the base install ca-certificates from the
#     same snapshot pin, so the bytes are the base's; the bundle check
#     (scripts/verify_netboot_initrd.py) compares them.
#
# The clock floor is NOT here: it changes with every revision, so it is a
# one-file layer scripts/build_netboot_bundle.sh puts in front of this cached
# initrd (R6).
#
# Self-contained on purpose (0008 p4-boot-chain s2a): no signed material (no
# ca.pem/bootstrap.json/boot-policy.json/release.pub.pem), no openssl/chronyd/
# blkid.
set -eu
case "${1:-}" in prereqs) exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions

# Do NOT hardcode 3.12: Debian trixie is 3.13. Derive the interpreter present.
python_bin=$(command -v python3)
real_python=$(readlink -f "$python_bin")
pyver=$("$python_bin" -c 'import sys; print("%d.%d" % sys.version_info[:2])')
libdir="/usr/lib/python${pyver}"

copy_exec "$real_python" "$real_python"
# The boot script execs /usr/bin/python3; keep that name resolvable.
ln -sf "$(basename "$real_python")" "${DESTDIR}/usr/bin/python3"

mkdir -p "${DESTDIR}${libdir}"
# Extension modules need their dynamic dependencies as well as the .so itself.
# copy_exec stops on an already-copied executable, so resolve dependencies
# first, then copy the stdlib tree over the top. Stage 1 imports ssl, hashlib,
# http.client, selectors, fcntl, array, secrets, socket, ... -- all served by
# the stdlib tree plus these lib-dynload .so's (_ssl, _hashlib, ...).
for extension in "${libdir}"/lib-dynload/*.so; do
    copy_exec "$extension" "$extension"
done
cp -a "${libdir}/." "${DESTDIR}${libdir}/"

# Stage 1: each listed package directory's import roots (its directories and
# modules; the path file itself is no import root), merged into the stdlib dir.
# A missing path file or directory fails the build.
stage1_path=/usr/lib/photo-wall/netboot-init/path
while IFS= read -r directory; do
    if [ ! -d "$directory" ]; then
        echo "photo-wall-netboot: $stage1_path names $directory, which is not installed" >&2
        exit 1
    fi
    for entry in "$directory"/*; do
        if [ -d "$entry" ] || [ "${entry%.py}" != "$entry" ]; then
            cp -a "$entry" "${DESTDIR}${libdir}/"
        fi
    done
done < "$stage1_path"

# The CA bundle stage 1 verifies Central against (R5).
mkdir -p "${DESTDIR}/etc/ssl/certs"
cp /etc/ssl/certs/ca-certificates.crt "${DESTDIR}/etc/ssl/certs/ca-certificates.crt"

# Only what LinuxOps.mount_root / ram / loop_device / command shell out to:
#   mount/umount  -- NOT staged here: initramfs-tools stages klibc-utils'
#                    over any copy a hook makes (v0.9.1's initrd held klibc's
#                    even though this hook copied util-linux's), so stage 1
#                    uses kernel mount options only and attaches the base's
#                    loop device itself (appliance/bootstrap.py
#                    KERNEL_MOUNT_OPTIONS, attached_loop). Their presence is
#                    checked by scripts/verify_netboot_initrd.py, and the real
#                    mounts by scripts/initrd_mount_probe.py.
#   modprobe      -- the loop driver, if it is a module not yet loaded
# configure_networking comes from initramfs-tools' own /scripts/functions
# (staged by initramfs-tools), so ip/ipconfig are not staged here. openssl/
# chronyd/blkid are deliberately absent: no signature check, no time daemon
# (stage 1's one SNTP step is uplink.clock), no block-device probe on this
# RAM-overlay path.
for program in modprobe; do
    executable=$(command -v "$program")
    copy_exec "$executable" "$executable"
done

# Minimal userland the HTTP-by-hostname fetch needs: name resolution + a root
# account for the interpreter. Carried over from the old hook (same python +
# networking path); NOT signed material.
mkdir -p "${DESTDIR}/etc"
printf '%s\n' 'root:x:0:0:root:/root:/bin/sh' > "${DESTDIR}/etc/passwd"
printf '%s\n' 'root:x:0:' > "${DESTDIR}/etc/group"
printf '%s\n' 'passwd: files' 'group: files' 'hosts: files dns' > "${DESTDIR}/etc/nsswitch.conf"
printf '%s\n' '127.0.0.1 localhost' '::1 localhost' > "${DESTDIR}/etc/hosts"

# The kernel package's WHOLE module tree, so every device on the board finds its
# driver by alias (issue 64: a hand-kept list -- MODULES=most plus vc4 and v3d
# -- left the Pi 5's HEVC decoder, codec@800000, with no driver, so the Player
# had no /dev/video*). The base has no kernel and no modules, so they travel
# with the kernel they were built for, and stage 1 copies this initrd's whole
# module tree onto the new root (appliance.netboot_init hand_over_modules),
# where the base's udev loads any of them by alias at coldplug -- as on any
# installed Debian system. This is the RAM-overlay mount's squashfs, overlay and
# loop too.
#
# initramfs-tools' own udev (init-top/udev) loads every initrd module whose
# alias matches a device, so they load in STAGE 1. That is wanted for the
# display: config.txt's vc4-kms-v3d-pi5 overlay turns the display nodes on and
# the legacy firmware framebuffer (brcm,bcm2708-fb) off, and vc4's framebuffer
# is then the console stage 1 prints its phase and FAILED lines on. Drivers stay
# loaded across switch_root.
#
# copy_modules_dir (hook-functions) adds every module under kernel/ through
# manual_add_modules, which dracut-install resolves with dependencies, softdeps
# and any firmware this root holds (the Wi-Fi and Bluetooth chips' firmware is
# not installed here or in the base, so those two drivers bind nothing).
# scripts/verify_netboot_initrd.py requires every module the kernel's
# modules.order names, and the Player's drivers by name (PLAYER_MODULES).
copy_modules_dir kernel
