[Unit]
Description=Accept the current Photo Wall trial after sustained Player health
Wants=photo-wall-player.service
After=photo-wall-player.service
OnFailure=photo-wall-trial-recovery.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3.12 -I -m appliance.updates --state-root /var/lib/photo-wall accept-current --config-dir /etc/photo-wall
TimeoutStartSec=200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/photo-wall
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
