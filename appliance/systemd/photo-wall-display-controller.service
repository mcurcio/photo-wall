[Unit]
Description=Photo Wall base display evidence controller
ConditionPathExists=/run/photo-wall-node/display.json
# One controller per Weston incarnation: it starts after Weston's READY=1 (control.sock bound),
# stops when that Weston ends and comes back with the next (the display unit Wants= it), so it
# never runs, or sets up its sandbox, while /run/photo-wall-display is absent.
BindsTo=photo-wall-display.service
After=photo-wall-display.service

After=photo-wall-node-handoff.service
# A crash loop leaves the unit failed and reported, never a reboot: recovery is
# operator-driven (no StartLimitAction).
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
User=pw-display
Group=pw-display
# pw-node-feeds lets the controller chown its display feed socket (0660); video opens the CEC
# devices (/dev/cecN, group video) and i2c the DDC/CI devices (/dev/i2c-N, group i2c) for the
# power methods (1b D2). Never a sysusers membership, which Weston's login session (and so the
# overlay client) would inherit. The base's sysusers.d declares i2c (E-1B-D2-1), so every root
# that installs this unit has the group: a missing one would fail the unit at start.
SupplementaryGroups=pw-node-feeds video i2c
LoadCredential=node-config:/run/photo-wall-node/display.json
ExecStart=/usr/bin/python3 -I -B /usr/lib/photo-wall/node/display-controller --config=%d/node-config
Restart=always
RestartSec=2
Slice=photowallbase.slice
OOMScoreAdjust=-500
MemoryMax=64M
TasksMax=16
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The power methods' devices, CEC (cec-ctl) and DDC/CI over i2c (ddcutil), and the DRM card node,
# where it reads the connector's signal range (group video; never master: Weston holds it).
DevicePolicy=closed
DeviceAllow=char-cec rw
DeviceAllow=char-i2c rw
DeviceAllow=char-drm rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ReadWritePaths=/run/photo-wall-display /run/photo-wall-display-feed
# What each display's picture last had (display_paths.CONTROLLER_STATE): kept across the
# controller's restarts with Weston, so a value set on the display's buttons is not written back;
# and the signal range last asked for (display_paths.SIGNAL_RANGE_REQUEST), which
# photo-wall-display-signal.path watches.
RuntimeDirectory=photo-wall-display-controller
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
InaccessiblePaths=-/run/photo-wall-host-core -/run/photo-wall-app-broker -/run/photo-wall-manager-supervisor
