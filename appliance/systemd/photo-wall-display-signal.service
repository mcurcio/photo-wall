[Unit]
Description=Photo Wall display restart for a signal range change
# Started by photo-wall-display-signal.path. A range change restarts Weston (and with it the
# controller and the Player): reset-failed first, on the display unit and on every unit bound to
# it (the controller, which the restart stops and starts again), so no run of range changes spends
# a crash start limit (StartLimitBurst=10 in 10 min on each); only crashes count. --no-block, so
# this oneshot never waits on the restart.

[Service]
Type=oneshot
ExecStart=-/usr/bin/systemctl reset-failed photo-wall-display.service photo-wall-display-controller.service
ExecStart=/usr/bin/systemctl --no-block restart photo-wall-display.service
