[Unit]
Description=Photo Wall base-owned Weston display policy
ConditionKernelCommandLine=photowall.node=v2
ConditionPathExists=/usr/lib/photo-wall/node-display/photo-wall-shell.so
After=systemd-user-sessions.service systemd-logind.service
Wants=systemd-logind.service
Conflicts=photo-wall-weston.service getty@tty1.service
# Each Weston incarnation brings its controller (which BindsTo= it) back after READY=1; see
# docs/display-host-backend.md#units-and-weston-incarnations.
Wants=photo-wall-display-controller.service
# A crash loop leaves the unit failed and reported, never a reboot: recovery is
# operator-driven (prior art photo-wall-provision.service, minus its StartLimitAction).
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
# READY=1 from Weston's own systemd-notify module, loaded after the shell has bound control.sock
# and Weston its Wayland socket; it pings the watchdog from Weston's event loop, so a hung
# compositor is aborted and restarted like a crashed one.
Type=notify
NotifyAccess=main
WatchdogSec=10s
User=pw-display
Group=pw-display
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=LIBSEAT_BACKEND=logind
Environment=XDG_SESSION_TYPE=wayland
SupplementaryGroups=video render input
RuntimeDirectory=photo-wall-display
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/photo-wall-display
Environment=PHOTO_WALL_CONTROLLER_UID=10005
# env restates XDG_RUNTIME_DIR because pam_systemd (PAMName=login) replaces it with /run/user/<uid>;
# env execs Weston, so the main PID (NotifyAccess=main) is Weston's.
ExecStart=/usr/bin/env XDG_RUNTIME_DIR=/run/photo-wall-display /usr/bin/weston --backend=drm --shell=/usr/lib/photo-wall/node-display/photo-wall-shell.so --modules=systemd-notify.so --socket=wayland-0 --idle-time=0
Restart=always
RestartSec=2
Slice=photowallbase.slice
OOMScoreAdjust=-500
# A memory-cgroup OOM kill of one child (the diagnostic client) must not stop Weston and spend
# its start limit; Weston itself being killed still ends the unit.
OOMPolicy=continue
MemoryMax=64M
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ReadWritePaths=/run/photo-wall-display
InaccessiblePaths=-/run/photo-wall-host-core -/run/photo-wall-app-broker -/run/photo-wall-manager-supervisor
