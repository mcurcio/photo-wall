[Unit]
Description=Admit and mount bounded diskless V2 node storage
Before=photo-wall-node-prepare.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /usr/lib/photo-wall-node-bootstrap storage
RemainAfterExit=yes
User=root
UMask=0077
TimeoutStartSec=15
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER
