[Unit]
Description=Photo Wall base OS observation agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/lib/photo-wall-bootstrapper/os-agent.py
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
