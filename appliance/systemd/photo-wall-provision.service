[Unit]
Description=Photo Wall base bootstrapper (discover central, fetch and install the Player app)
Documentation=file:///usr/share/doc/photo-wall/0009-minimal-base-and-app-package.md
Wants=network-online.target
After=network-online.target
# A base with no central on the LAN, or a central with no app promoted yet,
# must keep retrying (appliance.provision.Bootstrapper.run loops forever by
# default), so a single crash must not park the unit. But a unit that cannot
# make ANY progress -- a crash, or an exception the provisioner does not
# catch -- must not retry forever either (0014 rev 5, design §2.8): after 10
# exits in 10 minutes (about a minute of crash-restarts) the Pi reboots into
# PXE, which keeps retrying until the network answers and fetches the newest
# base. A provisioner that is merely WAITING on a failed fetch loops
# in-process (Restart is never triggered) and keeps waiting, uncounted.
StartLimitIntervalSec=10min
StartLimitBurst=10
StartLimitAction=reboot-force

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Installs a `.deb` into this running root and starts the resulting unit --
# needs broad filesystem and service-manager access, so this unit is
# deliberately unsandboxed (0009 owner ruling: home LAN, no threat model;
# see docs/decisions/0009-minimal-base-and-app-package.md).
ExecStart=/usr/bin/python3 -I -m appliance.provision
Restart=on-failure
RestartSec=5
TimeoutStartSec=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
