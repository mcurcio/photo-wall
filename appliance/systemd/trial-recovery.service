[Unit]
Description=Reboot only after a failed Photo Wall trial with a verified fallback
After=photo-wall-accept-trial.service

[Service]
Type=oneshot
User=root
Group=root
ExecCondition=/usr/bin/timeout 310 /usr/bin/python3.12 -I -m appliance.updates --state-root /var/lib/photo-wall rollback-current-allowed --config-dir /etc/photo-wall
ExecStart=/usr/bin/systemctl --no-block reboot
TimeoutStartSec=320
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/photo-wall
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
