[Unit]
Description=Reboot a failed stateless trial so central selects the accepted release
After=photo-wall-accept-trial.service

[Service]
Type=oneshot
User=root
Group=root
ExecCondition=/usr/bin/python3.12 -I -m appliance.updates reboot-required
ExecStart=/usr/bin/systemctl --no-block reboot
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/photo-wall
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
