# The nats-server pin (decision 0019): the Node bus's broker (decision 0017 C19) and CI's hub, at
# the line the bus fence was measured on (contracts/node_link.py). Its one version home, read
# by debian/rules (photo-wall-node's `nats-server (= ${nats:Version})`), by
# debian-packaging/build-repo.sh (upstream's own arm64 .deb into the local repo, refused unless
# its sha256 is the one below) and by scripts/nats_server.py (CI's hub and bus tests). Plain
# NAME=value lines: make, sh and Python read them alike. A bump edits both lines, from the
# release's SHA256SUMS. compose.yaml's hub image is held to the same version by a test.
NATS_SERVER_VERSION=2.15.0
NATS_SERVER_ARM64_DEB_SHA256=7e37abbab18910ebc6d7a4733546d061d1098c7ee35881a92ce9d451f5804d92
