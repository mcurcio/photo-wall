# The nats-py pin (decision 0019): the Node API library's NATS client (nodeapi), built by
# debian-packaging/build-repo.sh from upstream's sdist as python3-nats (this directory's
# source package) into the local repo. The sdist is uv.lock's nats-py sdist, byte for byte;
# tests/debs/test_pins.py holds all three lines to uv.lock and debian/changelog's version to
# <NATS_PY_VERSION>-1. A bump edits these lines, uv.lock and the changelog together.
# Plain NAME=value lines: sh and Python read them alike.
NATS_PY_VERSION=2.16.0
NATS_PY_SDIST_URL=https://files.pythonhosted.org/packages/2c/c8/739b72c9201081e48000884d476231873ac82f7247c43b33823eaf3c0bfb/nats_py-2.16.0.tar.gz
NATS_PY_SDIST_SHA256=1d137ed7afc9b59033b3199324c6237df2016a5091935871344a787eba6b72fc
