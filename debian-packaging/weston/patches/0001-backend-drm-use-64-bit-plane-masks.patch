+			drm_plane_destroy(drm_plane);
+			continue;
+		}
 		drm_plane->plane_idx = next_plane_idx++;
 
 		if (primary_plane_zpos_min != DRM_PLANE_ZPOS_INVALID_PLANE &&
@@ -1366,6 +1373,11 @@ create_sprites(struct drm_device *device)
 			drm_plane->is_underlay = true;
 			b->has_underlay = true;
 		}
+
+		weston_log("DRM: plane %u (%s) has plane index %u\n",
+			   drm_plane->plane_id,
+			   drm_output_get_plane_type_name(drm_plane),
+			   drm_plane->plane_idx);
 	}
 
 	if (b->has_underlay && !b->format->opaque_substitute) {
