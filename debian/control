 ${misc:Depends}
Description: Photo Wall AppManager launcher
 The manager root's program.

# The composition the base installs: the seven launchers (appliance/launchers/<launcher>/, each
# naming its PATH, which the import check holds to its entry's imports), the base's units, slices
# and target (enabled by debian/photo-wall-node.links), its system users and runtime directories,
# the bus configuration and the base ABI (debian/base-abi). nats-server is upstream's .deb, in the
# local repo at the pin; its licence ships in this package's doc directory.
Package: photo-wall-node
Architecture: all
Depends: photo-wall-common (= ${pw-version:photo-wall-common}),
 photo-wall-uplink (= ${pw-version:photo-wall-uplink}),
 photo-wall-node-kernel (= ${pw-version:photo-wall-node-kernel}),
 photo-wall-node-central-session (= ${pw-version:photo-wall-node-central-session}),
 photo-wall-node-host (= ${pw-version:photo-wall-node-host}),
 photo-wall-node-display (= ${pw-version:photo-wall-node-display}),
 photo-wall-node-health (= ${pw-version:photo-wall-node-health}),
 photo-wall-node-apps (= ${pw-version:photo-wall-node-apps}),
 photo-wall-node-boot (= ${pw-version:photo-wall-node-boot}),
 photo-wall-node-manager (= ${pw-version:photo-wall-node-manager}),
 nats-server (= ${nats:Version}),
 systemd,
 udev,
 ${misc:Depends}
Description: Photo Wall Node composition
 The base's units, slices and target, system users, runtime directories, the
 bus configuration, the launchers and the base ABI identity (abi.json).

# Stage 1 (decision 0019 P4): appliance.netboot_init and the two modules only it imports, under
# its directory, with its path file (/usr/lib/photo-wall/netboot-init/path: the package directories
# stage 1 reaches, one per line, sorted, held by the import check to import_check.launcher_path),
# the initramfs-tools hook that copies those directories and the CA bundle into the initrd, and the
# boot script. Stage 1 is stdlib-only, so it Depends on no Python provider; the tools the hook runs
# (python3, kmod, zstd) are the initrd build root's OS packages (base-image.yml), never Depends
# here (R4). The base never installs it.
Package: photo-wall-netboot-init
Architecture: all
Depends: initramfs-tools,
 photo-wall-common (= ${pw-version:photo-wall-common}),
 photo-wall-uplink (= ${pw-version:photo-wall-uplink}),
 photo-wall-node-boot (= ${pw-version:photo-wall-node-boot}),
 ${misc:Depends}
Description: Photo Wall stage 1 in the initramfs
 Stage 1 of the netboot and an initramfs-tools hook that copies it, the package
 directories it imports from and the CA bundle into the netboot initramfs.
