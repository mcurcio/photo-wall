# The app root's one package (debian-packaging/build-root.sh): the Player and its launcher, run
# as `python3 -I -B /usr/lib/photo-wall/player`. Its Python libraries are what its modules import
# (the import check); the render stack is loaded through gi and GStreamer, never imported by name.
# The frame client is the library the
# Player loads by path (player/wayland_frames.py). Players are Immich-unaware: nothing here
# reaches Central's or the media worker's code.
Package: photo-wall-player
Architecture: all
Depends: python3,
 python3-cryptography,
 python3-gi,
 python3-httpx,
 python3-opengl,
 python3-pydantic,
 python3-websockets,
 python3-zeroconf,
 python3-gst-1.0,
 gir1.2-gtk-3.0,
 gir1.2-gst-plugins-base-1.0,
 gstreamer1.0-plugins-base,
 gstreamer1.0-plugins-good,
 gstreamer1.0-plugins-bad,
 gstreamer1.0-libav,
 libgl1-mesa-dri,
 libegl1,
 photo-wall-common (= ${pw-version:photo-wall-common}),
 photo-wall-uplink (= ${pw-version:photo-wall-uplink}),
 photo-wall-frame-client (= ${pw-version:photo-wall-frame-client}),
 ${misc:Depends}
Description: Photo Wall Player
 The Player and its launcher: the app root's program.

# The manager root's one package: AppManager's launcher, run as
