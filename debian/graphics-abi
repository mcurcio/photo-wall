#!/bin/sh
# The display's ABI identity (decision 0019, ABI ownership): writes
# debian/photo-wall-node-display/usr/lib/photo-wall/node-display/abi.json as
#
#   {"graphics_abi": "weston14-<64 hex>", "plugin_abi": "frame-v3"}
#
# with no trailing newline (Python's json.dumps(sort_keys=True) form, which the Node and the
# release read). The hex is a sha256 over, first, the sorted lines `<package>/<path>\0<sha256>`
# of every regular file in the trees of photo-wall-node-display (less abi.json) and
# photo-wall-frame-client, DEBIAN aside: the compiled shell, the diagnostic client and the client
# library; then the sorted `dpkg-query -W -f '${binary:Package} ${Version} ${Architecture}\n'`
# of every package the two packages' expanded Depends name: the runtime they resolve against.
# The display's own version is not an input: debian/content-versions derives it from this tree,
# abi.json included (erratum E-0019-P1A-5).
#
# Run by debian/rules after dh_shlibdeps, when ${shlibs:Depends} is known; dpkg-gencontrol -O
# expands each package's Depends as dh_gencontrol will, without writing a control file.
# tests/debs/test_display_packages.py recomputes the identity from the installed packages.
set -eu

DISPLAY=photo-wall-node-display
CLIENT=photo-wall-frame-client
ABI=usr/lib/photo-wall/node-display/abi.json
PLUGIN_ABI=frame-v3

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# Appends to $2 the package names package $1's expanded Depends field holds (alternatives
# included), one per line.
depends() {
	dpkg-gencontrol -p"$1" -P"debian/$1" -T"debian/$1.substvars" -f"$scratch/files" \
		-O"$scratch/control"
	sed -n 's/^Depends: //p' "$scratch/control" | tr ',|' '\n\n' |
		sed -e 's/([^)]*)//g' -e 's/\[[^]]*\]//g' -e 's/:[a-z0-9]*//' -e 's/[[:space:]]//g' \
			-e '/^$/d' >> "$2"
}

# Every regular file of both trees, as `<package>/<path>`, abi.json aside, with its sha256.
for package in "$CLIENT" "$DISPLAY"; do
	(cd "debian/$package" && find . -type f ! -path './DEBIAN/*' -printf "$package/%P\n") \
		>> "$scratch/paths"
done
grep -vxF "$DISPLAY/$ABI" "$scratch/paths" | LC_ALL=C sort > "$scratch/files.sorted"
: > "$scratch/identity"
while IFS= read -r path; do
	digest=$(sha256sum < "debian/$path")
	printf '%s\000%s\n' "$path" "${digest%% *}" >> "$scratch/identity"
done < "$scratch/files.sorted"

# The resolved runtime: every package either Depends names, as installed in the build root.
: > "$scratch/names"
depends "$CLIENT" "$scratch/names"
depends "$DISPLAY" "$scratch/names"
# shellcheck disable=SC2046 # one package name per word
dpkg-query -W -f '${binary:Package} ${Version} ${Architecture}\n' \
	$(LC_ALL=C sort -u "$scratch/names") > "$scratch/runtime"
LC_ALL=C sort "$scratch/runtime" >> "$scratch/identity"

digest=$(sha256sum < "$scratch/identity")
printf '{"graphics_abi": "weston14-%s", "plugin_abi": "%s"}' "${digest%% *}" "$PLUGIN_ABI" \
	> "$scratch/abi.json"
install -D -m 0644 "$scratch/abi.json" "debian/$DISPLAY/$ABI"
