#!/usr/bin/make -f
# The Photo Wall source package (docs/decisions/0019-debian-packaging-with-debhelper.md).

# The nats-server pin's one home: photo-wall-node Depends on upstream's .deb at exactly it.
include debian-packaging/nats-server.env

# Meson is the source package's one build system: appliance/display_host builds the display
# (photo-wall-node-display) and the frame client (photo-wall-frame-client).
%:
	dh $@ --buildsystem=meson --sourcedirectory=appliance/display_host

# Every package's declared Depends against what its modules import, once each binary package's
# tree is staged (scripts/import_check.py). Not a test target: nocheck cannot skip it.
execute_after_dh_install:
	python3 -I -B scripts/import_check.py --control debian/control --staged debian --pyproject pyproject.toml

# The display's ABI identity, written into its tree once both trees are final (stripped, their
# shlibs resolved) and before debian/content-versions hashes them.
execute_after_dh_shlibdeps:
	debian/graphics-abi

# photo-wall-node.target is enabled by a link the package ships as data
# (debian/photo-wall-node.links), never by a maintainer script: the base's rpi-image-gen chroot and
# the PID1 fixture's image build run no systemd, the enablement is covered by the package's content
# version and by dpkg --verify, and no deb-systemd-helper state is baked into the image. No other
# package ships a unit.
override_dh_installsystemd:
	dh_installsystemd -Nphoto-wall-node

# nats-server's licence ships as upstream's text, readable where the base's docs are kept.
override_dh_compress:
	dh_compress -Xnats-server.LICENSE

# No -dbgsym packages: the local repo holds exactly debian/control's binary packages.
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# Every binary package at its own content-derived version (0019 Q1).
override_dh_gencontrol:
	debian/content-versions -Vnats:Version=$(NATS_SERVER_VERSION)
